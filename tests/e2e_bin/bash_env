# e2e 夹具：PATH 隔离（R11/A04）。Git Bash 的 MSYS 运行时会把 /mingw64/bin
# 注入 PATH 最前，导致真实 curl/python 抢在夹具前被解析；BASH_ENV 在每个
# 非交互 bash 启动时执行，重建 PATH——夹具目录必须排在首位，而不是
# 「存在于 PATH 任意位置」（A04：仅判断存在时系统 curl 仍会抢先）。
if [ -n "${VOICE_E2E_FIXTURE_BIN:-}" ]; then
  fixture_posix="$VOICE_E2E_FIXTURE_BIN"
  command -v cygpath >/dev/null 2>&1 && fixture_posix="$(cygpath -u "$VOICE_E2E_FIXTURE_BIN")"
  rest=""
  oldIFS="$IFS"
  IFS=':'
  for p in $PATH; do
    [ "$p" = "$fixture_posix" ] && continue
    if [ -z "$rest" ]; then rest="$p"; else rest="$rest:$p"; fi
  done
  IFS="$oldIFS"
  PATH="$fixture_posix:$rest"
  export PATH
fi
